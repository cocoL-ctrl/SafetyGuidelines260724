            detailTitle.innerHTML = page.title;
            detailContent.innerHTML = page.content;

            // Animate transition
            detailView.classList.remove('hidden');
            // Small delay to allow display:block to apply before animating opacity/transform
            setTimeout(() => {
                detailView.classList.add('slide-in-active');
                homeView.classList.add('opacity-0');
            }, 10);
            
            // Wait for transition to finish then hide home
            setTimeout(() => {
                homeView.classList.add('hidden');
                // Scroll detail to top
                detailView.scrollTop = 0;
            }, 300);
        }

        function goHome() {
            // Show home
            homeView.classList.remove('hidden');
            
            // Start animation
            setTimeout(() => {
                detailView.classList.remove('slide-in-active');
                homeView.classList.remove('opacity-0');
